# Hindsight Cloud (required for real memory). Without these the app falls back to local SQLite and says so.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=ap-exception-agent
# Optional: Gemini explanations. The app works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
